{
  "ConnectionStrings": {
    "meetupDb": "",
    "Redis": "localhost"
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Audience": "",
    "TokenValidationParameters": {
      "ValidIssuers": []
    },
    "MetadataAddress": "",
    "RequireHttpsMetadata": false
  },
  "KeyCloak": {
    "HealthUrl": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://localhost:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "eMeetup.Api"
    }
  },
  "Aspire": {
    "Seq": {
      "DisableHealthChecks": true,
      "ServerUrl": "http://localhost:5341"
    }
  },
  "Storage": {
    "Local": {
      "UploadPath": "wwwroot/uploads",
      "BaseUrl": "https://localhost:5001",
      "MaxFileSizeBytes": 5242880,
      "AllowedContentTypes": [
        "image/jpeg",
        "image/jpg",
        "image/png",
        "image/webp",
        "image/gif"
      ],
      "ThumbnailSize": 300
    }
  },
  "OTEL_EXPORTER_OTLP_ENDPOINT": ""
}